{
    "name": "web",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "next dev --port 5173",
        "build": "next build",
        "start": "next start",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "oxlint",
        "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run build"
    },
    "dependencies": {
        "next": "16.3.6",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "devDependencies": {
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "oxlint": "^1.71.0",
        "prettier": "^3.4.2",
        "sass": "^1.105.0",
        "typescript": "~5.9.3"
    }
}
