{
    "plugins": ["react", "typescript", "oxc"],
    "env": { "browser": true, "node": true, "es2023": true },
    "ignorePatterns": [".next"],
    "rules": {
        "react/rules-of-hooks": "error",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
    },
    "overrides": [
        {
            "files": ["src/app/**"],
            "rules": { "react/only-export-components": "off" }
        }
    ]
}
