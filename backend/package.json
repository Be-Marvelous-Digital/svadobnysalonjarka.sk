{
    "name": "svadobnysalonjarka-backend",
    "version": "1.0.0",
    "description": "REST API for Svadobn\u00fd sal\u00f3n Jarka \u2014 rezerv\u00e1cie, gal\u00e9ria, admin",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.test.json",
        "lint": "oxlint",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run build",
        "seed": "tsx src/seed/run.ts",
        "test": "NODE_ENV=test COOKIE_SECURE=false JWT_SECRET=test-secret-that-is-long-enough-for-the-schema ADMIN_USERNAME=admin ADMIN_PASSWORD=JarkaAdmin123 MONGODB_URI=\"${MONGODB_URI:-mongodb://127.0.0.1:27017/jarka_test}\" UPLOAD_DIR=\"$(mktemp -d)\" LOGIN_RATE_LIMIT=1000 RESERVATION_RATE_LIMIT=1000 API_RATE_LIMIT=100000 node --import tsx --test test/*.test.ts"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.8.1",
        "multer": "^2.2.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "sharp": "^0.35.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "oxlint": "^1.71.0",
        "prettier": "^3.4.2",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3"
    }
}
