{
    "name": "svadobnysalonjarka-backend",
    "version": "1.0.0",
    "description": "REST API for Svadobný salón Jarka — rezervácie, galéria, admin",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "oxlint",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run build",
        "seed": "tsx src/seed/run.ts"
    },
    "license": "UNLICENSED",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.8.1",
        "multer": "^2.2.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "sharp": "^0.35.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.1.2",
        "oxlint": "^1.71.0",
        "prettier": "^3.4.2",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3"
    }
}
