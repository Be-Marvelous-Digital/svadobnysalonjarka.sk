# Copy to backend/.env and fill in. Never commit the real file.

NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/svadobnysalonjarka

# Signs the admin session cookie. At least 32 characters:
#   openssl rand -base64 48
JWT_SECRET=

# Admin account written to the users collection by `npm run seed`. The seed never
# overwrites an existing account — to rotate the password, change it here, delete the
# user document, and re-seed. Change this before the site goes live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=JarkaAdmin123

# Where uploaded gallery photos are written. nginx serves this same directory.
UPLOAD_DIR=/var/lib/jarka/uploads

# Mailchimp hosted form endpoint. Every reservation request is forwarded to it as
# EMAIL / FNAME / PHONE / MSG / REQDATE. Leave it unset to turn the forwarding off.
# REQDATE has to exist on the audience as a Date merge field.
MAILCHIMP_SUBSCRIBE_URL=https://gmail.us18.list-manage.com/subscribe/post?u=838607befb59341147d65eda6&id=d7150fe930&f_id=0018ade6f0
MAILCHIMP_TIMEOUT_MS=5000

# Preferred over the form endpoint above. The form endpoint answers "success" to
# everything, including payloads it discards; the API returns the stored record,
# so the log shows which merge fields the audience actually kept.
# Key: Mailchimp -> Account -> Extras -> API keys. Audience ID: Audience ->
# Settings -> Audience name and defaults.
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=d7150fe930

PUBLIC_ORIGIN=https://svadobnysalonjarka.sk

# Set to false only for local http development, so the session cookie is accepted.
COOKIE_SECURE=true

# Only needed when the frontend runs on a different origin than the API.
# CORS_ORIGIN=http://localhost:5173

# Next.js revalidation webhook for local dev; docker-compose sets both itself.
# WEB_REVALIDATE_URL=http://localhost:5173/revalidate
# REVALIDATE_SECRET=
